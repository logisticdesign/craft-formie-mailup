{% import '_includes/forms' as forms %}
{% import 'verbb-base/_macros' as macros %}

{% set displayName = integration.displayName() %}

{% set instructions %}
### Connect to the {name} API
1. Go to the <a target="_blank" href="https://mailup.it" target="_blank">Mailup admin console</a>.
2. Select the List and click on Configurations > Advanced options > Developer options.
3. Create a new API key, copy the **Client ID** and **Client Secret** and paste into the fields below.
3. Insert the [Xmlsubscribe.aspx](https://helpmailup.atlassian.net/wiki/spaces/mailupapi/pages/36342599/HTTP+API+Specifications#Xmlsubscribe.aspx) URL, the List ID and if you want use Double Opt-In.
5. Then click the **Save** button.
{% endset %}

<div class="fui-settings-block">
    {{ instructions | t('formie', { name: displayName }) | md }}
</div>

{% if not craft.app.config.general.allowAdminChanges %}
    <span class="warning with-icon">
        {{ 'Integration settings can only be editable on an environment with `allowAdminChanges` enabled.' | t('formie') | md(inlineOnly=true) }}
    </span>
{% endif %}

{{ macros.proxyField(fieldVariables, 'autosuggestField', {
    label: 'Admin Console URL' | t('formie'),
    instructions: 'Enter your {name} {label} here.' | t('formie'),
    name: 'url',
    required: true,
    placeholder: 'http://xxxx.emailsp.com',
    suggestEnvVars: true,
    value: integration.settings.url ?? '',
    warning: macros.configWarning('url', 'formie'),
    errors: integration.getErrors('url'),
}) }}

{{ macros.proxyField(fieldVariables, 'autosuggestField', {
    label: 'List ID' | t('formie'),
    instructions: 'Enter your {name} {label} here.' | t('formie'),
    name: 'listId',
    required: true,
    placeholder: 'e.g. 1',
    suggestEnvVars: true,
    value: integration.settings.listId ?? '',
    warning: macros.configWarning('listId', 'formie'),
    errors: integration.getErrors('listId'),
}) }}

{{ macros.proxyField(fieldVariables, 'booleanMenuField', {
    label: 'Double Opt-In' | t('formie'),
    name: 'doubleOptIn',
    value: integration.settings.doubleOptIn ?? false,
    includeEnvVars: true,
    warning: macros.configWarning('doubleOptIn', 'formie'),
    errors: integration.getErrors('doubleOptIn'),
}) }}
